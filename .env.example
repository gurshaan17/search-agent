# Copy to .env and fill in credentials. Never commit .env.
# Required for chat, including when search results are mocked.
ANTHROPIC_API_KEY=

# Required when SEARCH_PROVIDER=exa; optional for mock.
EXA_API_KEY=

# Search backend: exa or mock. Mock implementation arrives in Phase 1.
SEARCH_PROVIDER=exa

# HTTP server port (integer from 1 through 65535).
PORT=3000

# Reserved for Phase 2: optional Anthropic model ID.
# Leave blank to use the agent default once implemented.
MODEL=

# Reserved for Phase 3: optional fixed ISO 8601 timestamp for repeatable recall.
# Example: 2026-11-11T04:30:00Z (10:00 in Asia/Kolkata).
# Leave blank to use the current time once implemented.
AGENT_NOW=
