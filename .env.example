# Required for live search and chat.
ANTHROPIC_API_KEY=
EXA_API_KEY=

# Optional model override; the agent default is selected in Phase 2.
MODEL=
# Optional fixed ISO timestamp for reproducible temporal behavior.
AGENT_NOW=
# exa (default) or mock. Mock needs no Exa key.
SEARCH_PROVIDER=exa
# HTTP server port.
PORT=3000
