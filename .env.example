# Copy to .env and fill in credentials. Never commit .env.
# Required for chat, including when search results are mocked.
GEMINI_API_KEY=

# Required when SEARCH_PROVIDER=exa; optional for mock.
EXA_API_KEY=

# Search backend: exa or mock. Mock returns empty results in browser/CLI chat; eval uses richer fixtures.
SEARCH_PROVIDER=exa

# HTTP server port (integer from 1 through 65535).
PORT=3000

# Optional Gemini model ID; default gemini-3.5-flash.
MODEL=

# Optional fixed ISO 8601 timestamp for repeatable agent time and dated recall.
# Example: 2026-11-11T04:30:00Z (10:00 in Asia/Kolkata).
# Leave blank to use the current time.
AGENT_NOW=

# CLI memory owner; reuse across sessions, change to isolate local histories.
CLI_USER_ID=local
